# Copy to .env and fill in real values before `docker compose up -d`.
#   cp .env.example .env

# --- PostgreSQL -------------------------------------------------------------
# Two roles: the owner (runs migrations) and the app role (used by omniagent
# at runtime, granted access by migrations — see team/store/migrations/0003).
POSTGRES_PASSWORD=change-me-owner-password
APP_DB_PASSWORD=change-me-app-password

# --- Team mode ---------------------------------------------------------
# Public domain Caddy serves and requests a certificate for.
DOMAIN=team.example.com
# Bootstrapped as superadmin on first login.
SUPERADMIN_EMAIL=you@example.com

# --- SMTP (magic-link email) ------------------------------------------------
# Leave blank to log magic links to the omniagent container's stdout instead
# of emailing them — fine for a first smoke test, not for real use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- LLM provider ------------------------------------------------------
# Needed for agents to actually reply; the management UI, catalog, and
# chats work without it.
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
